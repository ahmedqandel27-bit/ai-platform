# ─── Supabase ────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose. Used by the job worker / webhook to write results.
SUPABASE_SERVICE_ROLE_KEY=

# ─── App ─────────────────────────────────────────────────────
# Public URL of the deployed app (used for OAuth redirects and webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Higgsfield (server only — NEVER prefix with NEXT_PUBLIC_) ─
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Optional: secret used to verify incoming webhooks (if Higgsfield supports signing)
HIGGSFIELD_WEBHOOK_SECRET=

# ─── LLM for the Super Computer planner (Phase 5) ────────────
# higgsfield | anthropic | openai-compatible
LLM_PROVIDER=higgsfield
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
