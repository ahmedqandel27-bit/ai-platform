# ─── Supabase ────────────────────────────────────────────────
# Project Settings → API: the project URL and the anon (or publishable) key.
# Every query runs as the signed-in user under Row Level Security, so no
# service-role key is needed (don't add one).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Higgsfield (server only — NEVER prefix with NEXT_PUBLIC_) ─
# REST base URL. Leave as is.
HF_API_BASE_URL=https://api.higgsfield.ai
# Optional TEAM key: the complete key copied from https://open.higgsfield.ai/api-keys,
# pasted as-is. When set, signed-in team members can generate without pasting
# their own key (their own key, if connected, still takes precedence).
# Only used when Supabase auth is configured. Leave empty to require
# each user to click "Connect API key".
HF_API_KEY=
# Who may use HF_API_KEY: comma-separated e-mails and/or @domains.
# Empty = nobody (sign-ups are public by default, so this fails closed).
HF_API_KEY_ALLOWED=@your-agency.com

# ─── LLM for the Super Computer planner + "Enhance prompt" ───
# anthropic (default when a key is set) | openai-compatible | builtin
#   anthropic:          LLM_API_KEY (or ANTHROPIC_API_KEY); model defaults to claude-opus-5
#   openai-compatible:  LLM_BASE_URL + LLM_API_KEY + LLM_MODEL
#   builtin:            no key needed; a basic keyword planner, no text tools
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ─── Super Computer agent: thinking models in the picker ───
# Claude Opus 5.5 / Fable 5.1 / Sonnet 5.5 (LLM_API_KEY above also works with LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# GPT, Gemini, … via OpenRouter; optional list of "<openrouter id>=<label>" pairs
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
