# ─── Supabase ────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose. Used by the job worker / webhook to write results.
SUPABASE_SERVICE_ROLE_KEY=

# ─── App ─────────────────────────────────────────────────────
# Public URL of the deployed app (used for OAuth redirects and webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Higgsfield (server only — NEVER prefix with NEXT_PUBLIC_) ─
# REST base URL. Leave as is.
HF_API_BASE_URL=https://api.higgsfield.ai
# Optional TEAM key: the complete key copied from https://open.higgsfield.ai/api-keys,
# pasted as-is. When set, signed-in team members can generate without pasting
# their own key (their own key, if connected, still takes precedence).
# Only used when Supabase auth is configured. Leave empty to require
# each user to click "Connect API key".
HF_API_KEY=

# ─── LLM for the Super Computer planner (Phase 5) ────────────
# higgsfield | anthropic | openai-compatible
LLM_PROVIDER=higgsfield
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
